# Copy to server/.env for local development. Never commit the real .env file.
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/techfest2026?retryWrites=true&w=majority
# At least 32 random characters, e.g. node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_secret_of_32_or_more_chars
# Exact frontend origin(s), comma separated, no trailing slash
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
PORT=5000
